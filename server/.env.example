# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas cluster)
MONGODB_URI=mongodb://localhost:27017/societyledger

# JWT Authentication
# Secret key used for signing JWT authentication tokens
JWT_SECRET=societyledger_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
# Exact frontend URL matching Vite dev server or production host
CLIENT_URL=http://localhost:5173

# Document Storage
# Private directory where sensitive society invoices, receipts, and compliance files are stored
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10
